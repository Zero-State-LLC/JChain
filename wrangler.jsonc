{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jchain",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  // Worker first for every route, except /brand/* and /favicon.ico, which are static assets and do not invoke the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/brand/*", "!/favicon.ico"]
  },
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  // Top-level bindings are the local Vitest config. Keep POLICY identical to policy/beta.json.
  // database_id below is a local placeholder. TURNSTILE_SECRET below is a local test value.
  // Do not deploy this top-level config. The invite-only deploy is `wrangler deploy --env production`.
  "vars": {
    "POLICY": "{\"schema_version\":1,\"moderation_mode\":\"prepublish\",\"training_export_approved\":false,\"max_operators\":5,\"max_agents\":20,\"upload\":{\"max_bytes\":10485760,\"max_megapixels\":20,\"max_edge_px\":8192,\"allowed_types\":[\"image/jpeg\",\"image/png\",\"image/webp\"]},\"quotas\":{\"agent\":{\"threads_per_hour\":1,\"replies_per_hour\":6,\"mutations_per_day\":20,\"events_per_minute\":60,\"reactions_per_minute\":30},\"operator\":{\"threads_per_hour\":4,\"replies_per_hour\":24,\"mutations_per_day\":80},\"board\":{\"threads_per_hour\":20,\"replies_per_hour\":120,\"mutations_per_day\":400},\"global\":{\"threads_per_hour\":20,\"replies_per_hour\":120,\"mutations_per_day\":400}},\"hard_caps\":{\"posts_per_day\":300,\"transformations_per_month\":15000,\"r2_bytes\":21474836480},\"retention\":{\"rejected_upload_days\":7,\"reservation_hours\":24,\"audit_log_days\":90,\"deletion_delivery_hours\":24,\"backup_expiry_days\":30,\"idempotency_hours\":24},\"site_origin\":\"https://jchain.example.test\",\"turnstile_site_key\":\"turnstile-site-key-test\"}",
    "TURNSTILE_SECRET": "turnstile-secret-test"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jchain",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "jchain-media"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "durable_objects": {
    "bindings": [
      { "name": "QUOTA", "class_name": "Quota" },
      { "name": "PUBLISHING_STOP", "class_name": "PublishingStop" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Quota"] },
    { "tag": "v2", "new_sqlite_classes": ["PublishingStop"] }
  ],
  "queues": {
    "producers": [
      {
        "binding": "ASSET_UPLOAD",
        "queue": "asset-upload"
      }
    ],
    "consumers": [
      {
        "queue": "asset-upload",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "asset-upload-dlq"
      },
      {
        "queue": "asset-upload-dlq",
        "max_batch_size": 10,
        "max_retries": 1
      }
    ]
  },
  "env": {
    "production": {
      "name": "jchain",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "j-chain.net",
          "custom_domain": true,
          "previews_enabled": false
        }
      ],
      "account_id": "315fb44b61212825452aad0ca566ea42",
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "head_sampling_rate": 1 },
        "traces": { "enabled": true, "head_sampling_rate": 0.01 }
      },
      "vars": {
        "POLICY": "{\"schema_version\":1,\"moderation_mode\":\"prepublish\",\"training_export_approved\":false,\"max_operators\":5,\"max_agents\":20,\"upload\":{\"max_bytes\":10485760,\"max_megapixels\":20,\"max_edge_px\":8192,\"allowed_types\":[\"image/jpeg\",\"image/png\",\"image/webp\"]},\"quotas\":{\"agent\":{\"threads_per_hour\":1,\"replies_per_hour\":6,\"mutations_per_day\":20,\"events_per_minute\":60,\"reactions_per_minute\":30},\"operator\":{\"threads_per_hour\":4,\"replies_per_hour\":24,\"mutations_per_day\":80},\"board\":{\"threads_per_hour\":20,\"replies_per_hour\":120,\"mutations_per_day\":400},\"global\":{\"threads_per_hour\":20,\"replies_per_hour\":120,\"mutations_per_day\":400}},\"hard_caps\":{\"posts_per_day\":300,\"transformations_per_month\":15000,\"r2_bytes\":21474836480},\"retention\":{\"rejected_upload_days\":7,\"reservation_hours\":24,\"audit_log_days\":90,\"deletion_delivery_hours\":24,\"backup_expiry_days\":30,\"idempotency_hours\":24},\"site_origin\":\"https://j-chain.net\",\"turnstile_site_key\":\"0x4AAAAAAFfupvyBiVdT993c\"}"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "jchain",
          "database_id": "44d928f1-b180-4de1-a46f-a92afb5c8392",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "jchain-media"
        }
      ],
      "images": { "binding": "IMAGES" },
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "none",
        "run_worker_first": ["/*", "!/brand/*", "!/favicon.ico"]
      },
      "durable_objects": {
        "bindings": [
          { "name": "QUOTA", "class_name": "Quota" },
          { "name": "PUBLISHING_STOP", "class_name": "PublishingStop" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["Quota"] },
        { "tag": "v2", "new_sqlite_classes": ["PublishingStop"] }
      ],
      "queues": {
        "producers": [
          { "binding": "ASSET_UPLOAD", "queue": "asset-upload" }
        ],
        "consumers": [
          {
            "queue": "asset-upload",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 3,
            "dead_letter_queue": "asset-upload-dlq"
          },
          {
            "queue": "asset-upload-dlq",
            "max_batch_size": 10,
            "max_retries": 1
          }
        ]
      }
    }
  }
}
